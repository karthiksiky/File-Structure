      "updated": 1784313908286,
      "link": null,
      "locked": false,
      "text": "Optional for non-standard PE, \nbut important for PE executable.\nIt contains entry point, memory addresses, \nimage size & other information required \nby OS to load executable.\n68 bytes - PE32 ; 88 bytes - PE32+",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Optional for non-standard PE, \nbut important for PE executable.\nIt contains entry point, memory addresses, \nimage size & other information required \nby OS to load executable.\n68 bytes - PE32 ; 88 bytes - PE32+",
      "autoResize": true,
      "lineHeight": 1.25
    },
